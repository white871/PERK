import tkinter as PERK
from tkinter import messagebox

disconnecting = None


def disconnecting_popup():
    global disconnecting

    if disconnecting is not None:
        return  # Prevent multiple popups

    disconnecting = PERK.Toplevel(root)
    disconnecting.title("Bluetooth")
    disconnecting.geometry("300x150")
    disconnecting.resizable(False, False)

    label = PERK.Label(disconnecting, text="Brailler Disconnected!",
                     font=("Roboto Condensed", 15))
    label.pack(pady=20)

    connect_btn = PERK.Button(disconnecting, text="Ok", command = close_popup)
    connect_btn.pack(side="left", padx=50)

    '''connect_btn = PERK.Button(disconnecting, text="Ok",
                            command=connect_to_brailler)
    connect_btn.pack(side="left", padx=50)
    '''

    '''cancel_btn = PERK.Button(disconnecting, text="Cancel",
                           command=close_popup)
    cancel_btn.pack(side="right", padx=30)
    '''

    disconnecting.protocol("WM_DELETE_WINDOW", close_popup)


def connect_to_brailler():
    messagebox.showinfo("Bluetooth", "Connecting brailler...")
    close_popup()


def close_popup():
    global disconnecting
    if disconnecting:
        disconnecting.destroy()
        disconnecting = None


# Main window
root = PERK.Tk()
root.geometry("350x275")

open_btn = PERK.Button(root, text="Disconnect brailler?",
                     command=disconnecting_popup)
open_btn.pack(pady=100)

root.mainloop()
